<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The widget extension does not use data for tracking -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No tracking domains -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- Required Reason APIs used by this extension -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults: DriveWidgetHome reads the summary the app writes to the shared App Group suite -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- 1C8F.1: Read/write information shared only between members of the same App Group -->
                <string>1C8F.1</string>
            </array>
        </dict>
    </array>

    <!-- The extension collects no data; everything it shows is written on-device by the app -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
</dict>
</plist>
