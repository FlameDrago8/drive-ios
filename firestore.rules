rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // School accounts carry a custom claim set by the createSchoolAccount
    // Cloud Function via Admin SDK at school-account creation time.
    function isSchool() {
      return isAuth() && request.auth.token.get('role', '') == 'school';
    }

    function isSchoolFor(schoolCode) {
      return isSchool()
        && request.auth.token.get('schoolCode', '') == schoolCode
        && schoolActive(schoolCode);
    }

    // Billing kill-switch. schools/{code}.active is flipped only by the admin
    // provisioning script (suspend / reactivate) — rules block schools from
    // editing it themselves. A lapsed school loses dashboard access and new
    // student joins instantly; see the mirrored-drives note for what keeps
    // flowing during a suspension.
    function schoolActive(schoolCode) {
      return get(/databases/$(database)/documents/schools/$(schoolCode)).data.get('active', false) == true;
    }

    // True when the authenticated user's document shows they are linked to this school.
    // Used to gate drive mirroring — the user doc is already committed before
    // the mirror write happens (confirmJoin writes users/{uid} first).
    function studentLinkedTo(schoolCode) {
      return isAuth()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', '') == schoolCode;
    }


    // ── User data ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // School instructors can read any linked student's profile
      // (needed to display student names/avatars in the web dashboard).
      allow read: if isSchool()
        && get(/databases/$(database)/documents/users/$(userId)).data.get('orgId', '') == request.auth.token.get('schoolCode', '')
        && schoolActive(request.auth.token.get('schoolCode', ''));

      // Drives sub-collection
      match /drives/{driveId} {
        allow read, delete: if isOwner(userId);

        allow create, update: if isOwner(userId)
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100
          && request.resource.data.duration is number
          && request.resource.data.duration > 0
          && request.resource.data.duration < 86400;
      }

      // Public profile is readable by anyone (leaderboard badge display).
      match /public_profile/{document=**} {
        allow read:  if true;
        allow write: if isOwner(userId);
      }
    }


    // ── Schools ────────────────────────────────────────────────────────────────
    match /schools/{schoolCode} {
      // Any authenticated user can read (students need to fetch school name by code).
      // Because this doc is broadly readable, it holds ONLY non-sensitive
      // operational fields (name, active flags, ownerUid). Contact email and all
      // Stripe identifiers live in schools/{code}/private/billing and
      // stripe_index/{id} — no rule below grants those paths, so the catch-all
      // deny at the bottom blocks every client; only the Admin SDK (webhook +
      // provision script), which bypasses rules, can read or write them.
      allow read:  if isAuth();
      // School accounts can update their own school document (e.g. change name),
      // but never the billing/ownership fields — those belong to the admin script.
      // Creation is Admin SDK only (via the provision-school script).
      allow update: if isSchoolFor(schoolCode)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['active', 'subscriptionActive', 'ownerUid', 'createdAt']);
      allow create, delete: if false;

      // ── Student roster ─────────────────────────────────────────────────────
      // Written directly by the student (SchoolManager.confirmJoin / leaveSchool),
      // replacing the syncStudentRoster Cloud Function so no Blaze plan is needed.
      // A student may create/update/delete only their OWN entry, and only for a
      // school that exists AND is active (paid) — knowing the code (= the school
      // doc ID) is the join credential, and uid == studentId blocks impersonation.
      // The school reads the roster via its custom claim. Deletes stay allowed
      // regardless of school status so students can always leave.
      match /students/{uid} {
        allow read:  if isSchoolFor(schoolCode) || isOwner(uid);
        allow create, update: if isOwner(uid)
          && schoolActive(schoolCode)
          && request.resource.data.keys().hasOnly(['displayName', 'linkedAt', 'active'])
          && request.resource.data.active == true
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100;
        allow delete: if isOwner(uid);

        // ── Mirrored drives ───────────────────────────────────────────────────
        // The iOS app writes here directly (SchoolManager.mirrorDrive).
        // Allowed only when the student is actually linked to this school.
        // Score validation mirrors the users/{uid}/drives rule.
        // Deliberately NOT gated on schoolActive(): drives keep mirroring
        // through a suspension so a school that re-subscribes has a complete
        // history, and the iOS write path never starts failing for students.
        match /drives/{driveId} {
          allow read:  if isSchoolFor(schoolCode) || isOwner(uid);
          allow create: if isOwner(uid)
            && studentLinkedTo(schoolCode)
            && request.resource.data.score is number
            && request.resource.data.score >= 0
            && request.resource.data.score <= 100
            && request.resource.data.duration is number
            && request.resource.data.duration > 0;
          // No update/delete — mirrors are write-once from the app
        }
      }

      // ── Assignments ───────────────────────────────────────────────────────
      // Created/managed by school instructors via the web dashboard.
      // Students linked to this school can read.
      match /assignments/{assignmentId} {
        allow read:   if isSchoolFor(schoolCode) || studentLinkedTo(schoolCode);
        allow create, update: if isSchoolFor(schoolCode)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.type is string
          && request.resource.data.targetCount is number
          && request.resource.data.targetCount > 0;
        allow delete: if isSchoolFor(schoolCode);
      }
    }


    // ── Game Center ↔ Firebase UID cross-reference ─────────────────────────────
    match /gc_users/{gcId} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
    }


    // ── Anonymous training data ────────────────────────────────────────────────
    // Written by DriveStorage.uploadTrainingData when the user opts in to sharing.
    // Write-once, tagged with the author's uid; consumed only by the ML pipeline
    // via the Admin SDK (which bypasses these rules), so clients get no read.
    match /trainingData/{docId} {
      // Anonymized ML training samples. An authenticated request is required to
      // write (abuse prevention), but the document is anonymous by design and
      // must NOT carry a userID — authorization comes from the auth token, not
      // from an identity field stored in the data.
      allow create: if isAuth()
        && !('userID' in request.resource.data);
      allow read, update, delete: if false;
    }


    // ── Deny everything else ───────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
